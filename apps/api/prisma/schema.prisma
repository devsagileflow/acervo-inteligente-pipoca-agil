// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String              @id @default(ulid())
  name                String
  email               String
  emailVerified       Boolean             @default(false)
  image               String?
  role                Role[]
  sessions            Session[]
  accounts            Account[]
  analyticsEvents     AnalyticsEvent[]
  trailProgresses     TrailProgress[]
  trailItemProgresses TrailItemProgress[]
  feedbackResponses   FeedbackResponse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email])
  @@map("user")
}

enum Role {
  ADMIN
  USER
}

enum ContentType {
  VIDEO
  TRAIL
}

enum QuestionType {
  STARS
  SCALE_0_10
  LIKE_DISLIKE
  TEXT
  MULTIPLE_CHOICE
  SINGLE_CHOICE
}

model Session {
  id        String   @id @default(ulid())
  expiresAt DateTime
  token     String
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(ulid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(ulid())
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model AnalyticsEvent {
  id          String    @id @default(ulid())
  eventName   String // Click, PageView, etc.
  pagePath    String // URL 
  targetId    String? // ID of the target element, e.g., button ID, link ID, etc.
  anonymousId String?
  referrer    String? // e.g. previous page, search result, or external site that referred the traffic.
  properties  Json? // Additional properties related to the event, stored as a JSON object.
  occurredAt  DateTime?
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventName, createdAt])
  @@index([pagePath, createdAt])
  @@index([anonymousId, createdAt])
  @@index([userId, createdAt])
  @@map("analytics_event")
}

model Video {
  id                String    @id @default(ulid())
  title             String
  description       String?
  youtubeUrl        String
  durationInSeconds Int
  isActive          Boolean   @default(true)
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([title])
  @@index([isActive, deletedAt, createdAt])
  @@map("video")
}

model Trail {
  id              String              @id @default(ulid())
  title           String
  description     String?
  tags            String[]            @default([])
  specs           String[]            @default([])
  imageUrl        String?
  isPublished     Boolean             @default(false)
  isActive        Boolean             @default(true)
  deletedAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  items           TrailItem[]
  progressRecords TrailProgress[]
  itemProgresses  TrailItemProgress[]

  @@index([isPublished, deletedAt, createdAt])
  @@index([isActive, deletedAt, createdAt])
  @@map("trail")
}

model TrailItem {
  id              String              @id @default(ulid())
  trailId         String
  trail           Trail               @relation(fields: [trailId], references: [id], onDelete: Restrict)
  contentType     ContentType
  contentId       String
  position        Int
  isRequired      Boolean             @default(true)
  isActive        Boolean             @default(true)
  deletedAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  progressRecords TrailItemProgress[]

  @@index([trailId, deletedAt, position])
  @@index([contentType, contentId])
  @@map("trail_item")
}

model TrailProgress {
  id                   String    @id @default(ulid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  trailId              String
  trail                Trail     @relation(fields: [trailId], references: [id], onDelete: Cascade)
  completionPercentage Int       @default(0)
  isCompleted          Boolean   @default(false)
  completedAt          DateTime?
  lastViewedAt         DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([userId, trailId])
  @@index([userId, updatedAt])
  @@index([trailId, isCompleted])
  @@map("trail_progress")
}

model TrailItemProgress {
  id          String      @id @default(ulid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  trailId     String
  trail       Trail       @relation(fields: [trailId], references: [id], onDelete: Cascade)
  trailItemId String?
  trailItem   TrailItem?  @relation(fields: [trailItemId], references: [id], onDelete: SetNull)
  contentType ContentType
  contentId   String
  viewedAt    DateTime    @default(now())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([userId, trailItemId])
  @@index([userId, trailId, viewedAt])
  @@index([trailId, contentType, contentId])
  @@index([contentType, contentId])
  @@map("trail_item_progress")
}

model FeedbackForm {
  id          String             @id @default(ulid())
  title       String
  description String?
  contentType ContentType?
  contentId   String?
  isPublished Boolean            @default(false)
  isActive    Boolean            @default(true)
  deletedAt   DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  questions   FeedbackQuestion[]
  responses   FeedbackResponse[]

  @@index([isPublished, isActive, deletedAt, createdAt])
  @@index([contentType, contentId])
  @@map("feedback_form")
}

model FeedbackQuestion {
  id           String                   @id @default(ulid())
  formId       String
  form         FeedbackForm             @relation(fields: [formId], references: [id], onDelete: Cascade)
  questionType QuestionType
  label        String
  isRequired   Boolean                  @default(true)
  position     Int
  deletedAt    DateTime?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  options      FeedbackQuestionOption[]
  answers      FeedbackAnswer[]

  @@index([formId, position])
  @@map("feedback_question")
}

model FeedbackQuestionOption {
  id         String           @id @default(ulid())
  questionId String
  question   FeedbackQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label      String
  position   Int
  deletedAt  DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([questionId, position])
  @@map("feedback_question_option")
}

model FeedbackResponse {
  id        String           @id @default(ulid())
  formId    String
  form      FeedbackForm     @relation(fields: [formId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  deletedAt DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  answers   FeedbackAnswer[]

  @@index([formId, createdAt])
  @@index([userId, createdAt])
  @@map("feedback_response")
}

model FeedbackAnswer {
  id                String           @id @default(ulid())
  responseId        String
  response          FeedbackResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  questionId        String
  question          FeedbackQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)
  value             Json?
  selectedOptionIds String[]         @default([])
  deletedAt         DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([responseId])
  @@index([questionId])
  @@map("feedback_answer")
}
